# Copy to .env and adjust. All values are optional.

# Ollama endpoint and model. Any instruction-tuned model works; tested with
# qwen2.5:7b (default, ~5 GB, fits in 8 GB VRAM), qwen2.5:3b (fast) and qwen3:8b.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Characters sent to the LLM per call. Smaller chunks = better recall on small models.
LLM_CHUNK_SIZE=1800
LLM_CHUNK_OVERLAP=200

# Limits
MAX_UPLOAD_MB=10
MAX_PAGES=50

# Results (including original text and re-identification mapping) are erased after this.
JOB_TTL_SECONDS=900

# Host port used by docker compose
APP_PORT=8000
LOG_LEVEL=INFO
